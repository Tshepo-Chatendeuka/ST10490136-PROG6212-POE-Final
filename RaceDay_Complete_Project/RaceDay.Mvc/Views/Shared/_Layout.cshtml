<!DOCTYPE html>
<html>
<head>
    <title>RaceDay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">RaceDay</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    @if (Context.Session.GetInt32("UserId") == null) {
                        <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Register">Register</a></li>
                    } else if (Context.Session.GetString("Role") == "Organiser") {
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent">New Event</a></li>
                    } else {
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Index">Events</a></li>
                    }
                </ul>
                @if (Context.Session.GetInt32("UserId") != null) {
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-flex">
                        <button class="btn btn-outline-danger" type="submit">Logout</button>
                    </form>
                }
            </div>
        </div>
    </nav>
    <div class="container mt-4">@RenderBody()</div>
</body>
</html>
