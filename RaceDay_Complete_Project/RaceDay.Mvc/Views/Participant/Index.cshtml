@model List<RaceDay.Contracts.EventDto>
<h1>Upcoming Events</h1>
<div class="row">
    @if(Model != null) {
        foreach(var e in Model) {
            <div class="col-md-4">
                <div class="card mb-3">
                    @if(!string.IsNullOrEmpty(e.BannerImageUrl)){ <img src="@e.BannerImageUrl" class="card-img-top"/> }
                    <div class="card-body">
                        <h5 class="card-title">@e.Name</h5>
                        <p>@e.EventDate.ToShortDateString() | @e.Location</p>
                        <button class="btn btn-primary">Enter Event</button>
                    </div>
                </div>
            </div>
        }
    }
</div>
