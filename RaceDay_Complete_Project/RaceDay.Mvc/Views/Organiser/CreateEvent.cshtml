@model RaceDay.Contracts.CreateEventRequest
<h1>Create Event</h1>
<form method="post" enctype="multipart/form-data">
    <div class="mb-3"><label>Name</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label>Description</label><input asp-for="Description" class="form-control" /></div>
    <div class="mb-3"><label>Event Date</label><input asp-for="EventDate" type="date" class="form-control" /></div>
    <div class="mb-3"><label>Location</label><input asp-for="Location" class="form-control" /></div>
    <div class="mb-3"><label>Distance (km)</label><input asp-for="DistanceKm" type="number" step="0.1" class="form-control" /></div>
    <div class="mb-3">
        <label>Event Type</label>
        <select asp-for="EventType" class="form-select">
            <option>Run</option><option>Walk</option><option>Cycle</option>
        </select>
    </div>
    <div class="mb-3"><label>Banner Image</label><input type="file" name="banner" class="form-control" accept="image/*" /></div>
    <button type="submit" class="btn btn-success">Create</button>
</form>
