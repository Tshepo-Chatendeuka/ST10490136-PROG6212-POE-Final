@model List<RaceDay.Contracts.EventDto>
<h1>Organiser Dashboard</h1>
<table class="table">
    <tr><th>Name</th><th>Date</th><th>Location</th><th>Banner</th></tr>
    @if(Model != null) {
        foreach(var e in Model) {
            <tr>
                <td>@e.Name</td><td>@e.EventDate.ToShortDateString()</td><td>@e.Location</td>
                <td>@if(!string.IsNullOrEmpty(e.BannerImageUrl)){ <img src="@e.BannerImageUrl" height="50"/> }</td>
            </tr>
        }
    }
</table>
